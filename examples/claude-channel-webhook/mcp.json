{
  "mcpServers": {
    "webhook-channel": {
      "command": "npx",
      "args": [
        "-y",
        "@smallchat/core",
        "channel",
        "--name", "webhook",
        "--two-way",
        "--http-bridge",
        "--http-bridge-port", "3002",
        "--instructions", "This channel receives webhook notifications. Summarize events concisely and respond to user questions about them."
      ],
      "env": {
        "SMALLCHAT_CHANNEL_SECRET": "${SMALLCHAT_CHANNEL_SECRET}"
      }
    }
  }
}
