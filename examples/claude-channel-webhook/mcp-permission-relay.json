{
  "mcpServers": {
    "webhook-channel": {
      "command": "npx",
      "args": [
        "-y",
        "@smallchat/core",
        "channel",
        "--name", "webhook",
        "--two-way",
        "--permission-relay",
        "--http-bridge",
        "--http-bridge-port", "3002",
        "--http-bridge-tokens-file", "${HOME}/.smallchat/channel-tokens.json",
        "--sender-allowlist", "alice@example.com,bob@example.com",
        "--permission-approvers", "alice@example.com"
      ]
    }
  }
}
